---
import { getCopy } from "../copy";

const { problem } = getCopy(Astro.currentLocale);
---

<section class="border-y border-slate-900 bg-slate-950/40">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-slate-400"
      >
        {problem.eyebrow}
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl"
      >
        {problem.heading}
      </h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        problem.items.map((it) => (
          <div class="reveal rounded-2xl border border-slate-800/80 bg-slate-900/30 p-6">
            <h3 class="text-base font-semibold text-slate-200">{it.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{it.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
