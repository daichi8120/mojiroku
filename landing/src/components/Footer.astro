---
import { getCopy } from "../copy";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { footer } = getCopy(Astro.currentLocale);
---

<footer class="border-t border-slate-900 bg-slate-950">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img
            src="/favicon.svg"
            alt=""
            width="28"
            height="28"
            class="rounded-lg"
          />
          <span class="font-mono text-sm font-medium text-slate-100"
            >mojiroku</span
          >
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-400">{footer.tagline}</p>
      </div>

      <nav class="flex flex-col gap-4 sm:items-end" aria-label={footer.ariaLabel}>
        {
          footer.links.map((l) => (
            <a
              href={l.href}
              class="group text-sm text-slate-300 transition hover:text-indigo-300"
            >
              {l.title}
              <span class="ml-2 text-slate-500 group-hover:text-slate-400">
                {l.body}
              </span>
            </a>
          ))
        }
        <LanguageSwitcher />
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col items-center gap-2 border-t border-slate-900 pt-6 text-center font-mono text-xs text-slate-500"
    >
      <p>© {footer.year} {footer.copyright}</p>
      <a href={footer.privacy.href} class="transition hover:text-slate-300">
        {footer.privacy.label}
      </a>
    </div>
  </div>
</footer>
