---
import { getCopy } from "../copy";

const { privacy } = getCopy(Astro.currentLocale);
---

<section
  id="privacy"
  class="relative overflow-hidden border-y border-emerald-900/30 bg-emerald-950/10"
>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.2em] text-emerald-400"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
        </svg>
        {privacy.eyebrow}
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl"
      >
        {privacy.heading}
      </h2>
      <p class="mt-5 text-base leading-8 text-slate-400">{privacy.body}</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {
        privacy.bullets.map((b) => (
          <div class="reveal flex gap-4 rounded-2xl border border-emerald-900/30 bg-slate-900/40 p-6">
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-300">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l4.5 4.5L19 7" />
              </svg>
            </span>
            <p class="text-sm leading-7 text-slate-300">{b}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
