---
import { getCopy } from "../copy";

const { privacy } = getCopy(Astro.currentLocale);
---

<section
  id="privacy"
  class="relative overflow-hidden border-y border-emerald-900/30 bg-emerald-950/10"
>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.2em] text-emerald-400"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
        </svg>
        {privacy.eyebrow}
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl"
      >
        {privacy.heading}
      </h2>
      <p class="mt-5 text-base leading-8 text-slate-400">{privacy.body}</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {
        privacy.bullets.map((b) => (
          <div class="reveal flex gap-4 rounded-2xl border border-emerald-900/30 bg-slate-900/40 p-6">
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-300">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l4.5 4.5L19 7" />
              </svg>
            </span>
            <p class="text-sm leading-7 text-slate-300">{b}</p>
          </div>
        ))
      }
    </div>

    <div
      class="reveal mt-8 flex flex-col gap-4 rounded-2xl border border-indigo-900/40 bg-indigo-500/[0.06] p-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-2xl text-sm leading-7 text-slate-300">
        {privacy.source.text}
      </p>
      <a
        href={privacy.source.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex flex-none items-center gap-2 rounded-xl border border-indigo-500/40 bg-indigo-500/10 px-4 py-2.5 text-sm font-medium text-indigo-200 transition hover:border-indigo-400/60 hover:bg-indigo-500/20 hover:text-indigo-100"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49
               0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5
               -.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85
               .09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75
               -.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 2.5-.34c.85 0
               1.71.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72
               1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01
               2.480-.01 2.81 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"
          />
        </svg>
        {privacy.source.label}
        <span class="whitespace-nowrap font-mono text-xs text-indigo-400/80">
          {privacy.source.note}
        </span>
      </a>
    </div>
  </div>
</section>
