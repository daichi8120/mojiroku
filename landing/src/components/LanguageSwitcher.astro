---
// 言語スイッチャー。リンク先・表示名は copy が「もう一方の言語」を持つ。
// クリックで選択を localStorage に保存し、Layout の初回振り分けより優先させる
// （EN ブラウザで「日本語」を選んだ人が / に戻るたび /en/ へ跳ばされるのを防ぐ）。
import { getCopy } from "../copy";

const { nav } = getCopy(Astro.currentLocale);
const { class: className = "" } = Astro.props;
const targetLang = Astro.currentLocale === "en" ? "ja" : "en";
---

<a
  href={nav.langSwitch.href}
  onclick={`try{localStorage.setItem('mojiroku_lang','${targetLang}')}catch(e){}`}
  class={`inline-flex items-center gap-1.5 text-sm text-slate-400 transition hover:text-slate-100 ${className}`}
>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"></path>
  </svg>
  {nav.langSwitch.label}
</a>
