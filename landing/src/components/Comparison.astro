---
import { getCopy } from "../copy";

const { comparison } = getCopy(Astro.currentLocale);
---

<section id="comparison" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p
      class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-indigo-400"
    >
      {comparison.eyebrow}
    </p>
    <h2
      class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl"
    >
      {comparison.heading}
    </h2>
    <p class="mt-5 text-base leading-8 text-slate-400">{comparison.body}</p>
  </div>

  {/* デスクトップ/タブレット: 表（md 未満では横スクロールで右列が隠れるため下の縦積みに切替） */}
  <div
    class="reveal mx-auto mt-12 hidden max-w-4xl overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/40 md:block"
  >
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-800">
          <th scope="col" class="px-5 py-4"></th>
          <th
            scope="col"
            class="border-x border-indigo-500/20 bg-indigo-500/10 px-5 py-4 align-bottom"
          >
            <span class="font-mono text-[11px] uppercase tracking-wider text-indigo-300"
              >{comparison.cols.a.name}</span
            >
            <span class="mt-1 block text-xs font-normal text-slate-400"
              >{comparison.cols.a.sub}</span
            >
          </th>
          <th scope="col" class="px-5 py-4 align-bottom">
            <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400"
              >{comparison.cols.b.name}</span
            >
            <span class="mt-1 block text-xs font-normal text-slate-400"
              >{comparison.cols.b.sub}</span
            >
          </th>
        </tr>
      </thead>
      <tbody>
        {
          comparison.rows.map((r) => (
            <tr class="border-b border-slate-800/70 last:border-0">
              <th
                scope="row"
                class="px-5 py-4 text-sm font-medium text-slate-300"
              >
                {r.k}
              </th>
              <td
                class={`border-x border-indigo-500/20 bg-indigo-500/[0.06] px-5 py-4 ${r.highlight ? "text-emerald-300" : "text-slate-200"}`}
              >
                <span class="flex items-start gap-2">
                  {r.highlight && (
                    <svg class="mt-0.5 flex-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12l4.5 4.5L19 7" />
                    </svg>
                  )}
                  <span>{r.a}</span>
                </span>
              </td>
              <td class="px-5 py-4 text-slate-400">{r.b}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {/* モバイル: 各観点を縦積みカードに。横スクロール無しで mojiroku/クラウド両方を表示 */}
  <div class="reveal mt-10 space-y-4 md:hidden">
    {
      comparison.rows.map((r) => (
        <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5">
          <p class="text-sm font-semibold text-slate-200">{r.k}</p>
          <div class="mt-3 space-y-2.5">
            <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/[0.06] px-4 py-3">
              <p class="font-mono text-[10px] uppercase tracking-wider text-indigo-300">
                {comparison.cols.a.name}
                <span class="ml-1.5 font-sans normal-case text-slate-500">
                  {comparison.cols.a.sub}
                </span>
              </p>
              <p
                class={`mt-1.5 flex items-start gap-2 text-sm ${r.highlight ? "text-emerald-300" : "text-slate-200"}`}
              >
                {r.highlight && (
                  <svg class="mt-0.5 flex-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l4.5 4.5L19 7" />
                  </svg>
                )}
                <span>{r.a}</span>
              </p>
            </div>
            <div class="rounded-xl border border-slate-800 px-4 py-3">
              <p class="font-mono text-[10px] uppercase tracking-wider text-slate-400">
                {comparison.cols.b.name}
                <span class="ml-1.5 font-sans normal-case text-slate-500">
                  {comparison.cols.b.sub}
                </span>
              </p>
              <p class="mt-1.5 text-sm text-slate-400">{r.b}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <p class="reveal mx-auto mt-5 max-w-3xl text-center text-xs leading-6 text-slate-500">
    {comparison.notes}
  </p>
</section>
