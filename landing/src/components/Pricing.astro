---
import { getCopy } from "../copy";

const { pricing } = getCopy(Astro.currentLocale);
---

<section class="border-y border-slate-900 bg-slate-950/40">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-indigo-400"
      >
        {pricing.eyebrow}
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl"
      >
        {pricing.heading}
      </h2>
      <p class="mt-5 text-base leading-8 text-slate-400">{pricing.body}</p>
    </div>

    <div
      class="reveal mx-auto mt-12 max-w-xl rounded-3xl border border-indigo-500/30 bg-slate-900/60 p-8 text-center shadow-2xl shadow-indigo-950/40 sm:p-10"
    >
      <p class="font-mono text-sm uppercase tracking-[0.2em] text-indigo-400">
        {pricing.freeLabel}
      </p>
      <p class="mt-3 flex items-end justify-center gap-2">
        <span class="text-6xl font-bold tracking-tight text-slate-50">{pricing.price}</span>
        <span class="mb-2 text-sm text-slate-400">{pricing.priceNote}</span>
      </p>

      <ul class="mt-8 space-y-3.5 text-left">
        {
          pricing.bullets.map((b) => (
            <li class="flex gap-3">
              <span class="mt-1 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l4.5 4.5L19 7" />
                </svg>
              </span>
              <span class="text-sm leading-7 text-slate-300">{b}</span>
            </li>
          ))
        }
      </ul>

      <a
        href={pricing.cta.href}
        class="mt-9 inline-block w-full rounded-xl bg-indigo-600 px-7 py-3.5 text-base font-semibold text-white shadow-xl shadow-indigo-950/50 transition hover:bg-indigo-500"
      >
        {pricing.cta.label}
      </a>
    </div>
  </div>
</section>
