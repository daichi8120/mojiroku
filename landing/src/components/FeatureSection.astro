---
import ScreenshotFrame from "./ScreenshotFrame.astro";

interface Feature {
  id: string;
  eyebrow: string;
  heading: string;
  body: string;
  bullets: string[];
  image: string;
  screenshotCaption: string;
  label: string;
  badge: string | null;
}
interface Props {
  feature: Feature;
  reverse?: boolean;
}
const { feature, reverse = false } = Astro.props;
---

<div class="reveal grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
  <div class={reverse ? "lg:order-2" : ""}>
    <div class="flex items-center gap-3">
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-indigo-400"
      >
        {feature.eyebrow}
      </p>
      {
        feature.badge && (
          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wide text-emerald-300">
            {feature.badge}
          </span>
        )
      }
    </div>

    <h3
      class="mt-3 text-2xl font-bold tracking-tight text-slate-50 sm:text-3xl"
    >
      {feature.heading}
    </h3>
    <p class="mt-4 text-base leading-8 text-slate-400">{feature.body}</p>

    <ul class="mt-6 space-y-3.5">
      {
        feature.bullets.map((b) => (
          <li class="flex gap-3">
            <span class="mt-1 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l4.5 4.5L19 7" />
              </svg>
            </span>
            <span class="text-sm leading-7 text-slate-300">{b}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class={reverse ? "lg:order-1" : ""}>
    <ScreenshotFrame
      src={feature.image}
      label={feature.label}
      caption={feature.screenshotCaption}
      ratio="16/10"
    />
  </div>
</div>
