---
import { getCopy } from "../copy";

const { howItWorks } = getCopy(Astro.currentLocale);
---

<section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p
      class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-indigo-400"
    >
      {howItWorks.eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
      {howItWorks.heading}
    </h2>
  </div>

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    {
      howItWorks.items.map((it, i) => (
        <div class="reveal relative rounded-2xl border border-slate-800 bg-slate-900/50 p-7">
          <span class="font-mono text-5xl font-bold text-indigo-500/30">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-4 text-lg font-semibold text-slate-100">{it.title}</h3>
          <p class="mt-2.5 text-sm leading-7 text-slate-400">{it.body}</p>
        </div>
      ))
    }
  </div>
</section>
