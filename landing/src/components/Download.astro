---
import { getCopy } from "../copy";

const { download } = getCopy(Astro.currentLocale);
---

<section
  id="download"
  class="relative overflow-hidden border-t border-slate-900"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-0 mx-auto h-72 max-w-3xl rounded-full bg-indigo-600/15 blur-[120px]"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
    <p
      class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-indigo-400"
    >
      {download.eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
      {download.heading}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-8 text-slate-400">
      {download.body}
    </p>

    <div class="mt-9">
      <a
        href={download.cta.href}
        class="inline-block rounded-xl bg-indigo-600 px-8 py-4 text-lg font-semibold text-white shadow-xl shadow-indigo-950/50 transition hover:bg-indigo-500"
      >
        {download.cta.label}
      </a>
      <p class="mt-3 text-sm text-slate-400">{download.meta}</p>
    </div>

    {/* インストール手順 */}
    <div class="mt-16 text-left">
      <h3 class="text-center text-base font-semibold text-slate-300">
        {download.stepsHeading}
      </h3>
      <ol class="mt-7 space-y-5">
        {
          download.steps.map((s) => (
            <li class="flex gap-4">
              <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full border border-indigo-500/30 bg-indigo-500/10 text-sm font-semibold text-indigo-300">
                {s.n}
              </span>
              <div class="min-w-0">
                <p class="font-medium text-slate-200">{s.title}</p>
                <p class="mt-1 text-sm leading-7 text-slate-400">{s.body}</p>
                {s.code && (
                  <code class="mt-2.5 block overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 px-3.5 py-2.5 font-mono text-[13px] text-indigo-200">
                    {s.code}
                  </code>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
