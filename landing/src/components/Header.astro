---
import { getCopy } from "../copy";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { nav } = getCopy(Astro.currentLocale);
---

<header
  class="sticky top-0 z-50 border-b border-slate-800/60 bg-slate-950/70 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="#top" class="flex items-center gap-2.5">
      <img
        src="/favicon.svg"
        alt=""
        width="28"
        height="28"
        class="rounded-lg"
      />
      <span class="font-mono text-sm font-medium tracking-tight text-slate-100"
        >mojiroku</span
      >
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label={nav.ariaLabel}>
      {
        nav.links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-slate-400 transition hover:text-slate-100"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5">
      <LanguageSwitcher />
      <a
        href={nav.cta.href}
        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-950/40 transition hover:bg-indigo-500"
      >
        {nav.cta.label}
      </a>
    </div>
  </div>
</header>
