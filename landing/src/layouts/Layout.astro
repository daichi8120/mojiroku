---
// セルフホストフォント（Noto Sans JP 本文 / DM Mono ラベル・数値）。Google CDN は使わない。
// フルウェイト(.css)は 124 個の unicode-range サブセット定義を全部読み込み render-blocking CSS を肥大させるため、
// 当ページで使う japanese + latin サブセットだけを import する（@font-face を大幅削減）。
import "@fontsource/noto-sans-jp/japanese-400.css";
import "@fontsource/noto-sans-jp/japanese-500.css";
import "@fontsource/noto-sans-jp/japanese-700.css";
import "@fontsource/noto-sans-jp/latin-400.css";
import "@fontsource/noto-sans-jp/latin-500.css";
import "@fontsource/noto-sans-jp/latin-700.css";
import "@fontsource/dm-mono/latin-400.css";
import "@fontsource/dm-mono/latin-500.css";
import "../styles/global.css";
import { getCopy } from "../copy";
import { localePaths } from "../lib/locale-path.js";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const locale = Astro.currentLocale ?? "ja";
const copy = getCopy(locale);

const {
  title = copy.meta.title,
  description = copy.meta.description,
  ogImage = locale === "en" ? "/og.en.png" : "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// hreflang は**このページの**言語別 URL を指す必要がある。以前は `/` と `/en/` の
// 決め打ちで、/privacy でも LP を自分の別言語版として宣言していた（2026-08-29 に修正）。
const altPaths = localePaths(Astro.url.pathname);
const altJa = new URL(altPaths.ja, Astro.site).href;
const altEn = new URL(altPaths.en, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site);
const ogLocale = locale === "en" ? "en_US" : "ja_JP";
const ogLocaleAlternate = locale === "en" ? "ja_JP" : "en_US";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "mojiroku",
  applicationCategory: "BusinessApplication",
  operatingSystem: "macOS 11+ (Apple Silicon)",
  description,
  inLanguage: locale,
  url: "https://mojiroku.com",
  downloadUrl: "https://mojiroku.com/download",
  image: ogImageUrl.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

// Cloudflare Web Analytics（Cookieless・無料・$0 とプライバシー思想に一致）。
// CF ダッシュボード → Web Analytics →「Add a site」で mojiroku.com を追加すると
// beacon トークン（HTML に載る公開ID。秘匿不要）が発行される。それをここに貼ると計測が有効化。
// 空文字のままなら beacon を一切読み込まない（リクエストゼロ）。
const cfAnalyticsToken = "d67065832e4544aca7b320b7d5158710";

// 初回訪問の言語振り分け（ja ページ = `/` のみに注入）。優先順: 明示的な言語選択
// （localStorage、スイッチャーで保存）→ ブラウザ言語（ja 系以外は /en/ へ）。
// head 先頭の同期スクリプトなので描画前に replace され、ちらつきは出ない。
// ボットは除外 = `/` は日本語として索引され続け、言語版の案内は hreflang に任せる
// （JS リダイレクトを Googlebot が踏むと ja ページが索引から落ちるリスクがあるため）。
// ⚠️ Astro は <script> 内の {式} を処理しない（波括弧ごと素通しになる）ため set:html で注入する。
// リダイレクト先は**このページの英語版**。以前は "/en/" 決め打ちで、
// /privacy を英語ブラウザで開くと英語 LP へ飛ばされ、日本語ポリシーに到達できなかった
// （2026-08-29 のレビュー指摘。Google の審査担当者がまさにこの条件で開く）。
const langRedirectJs = `(function () {
  var EN_URL = ${JSON.stringify(altPaths.en)};
  try {
    if (/bot|crawler|spider|lighthouse/i.test(navigator.userAgent)) return;
    var pref = localStorage.getItem("mojiroku_lang");
    if (pref === "ja") return;
    var first = (navigator.languages && navigator.languages[0]) || navigator.language || "";
    var isJa = first.toLowerCase().indexOf("ja") === 0;
    if (pref === "en" || !isJa) location.replace(EN_URL + location.hash);
  } catch (e) {
    /* localStorage 不可などは日本語のまま表示 */
  }
})();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {locale === "ja" && <script is:inline set:html={langRedirectJs} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    {/* hreflang: このページの ja / en を指す（x-default は ja）。sitemap.xml.ts と同じ対応 */}
    <link rel="alternate" hreflang="ja" href={altJa} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altJa} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mojiroku" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.layout.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={copy.layout.ogImageAlt} />

    <link rel="sitemap" href="/sitemap.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    {/* Cloudflare Web Analytics（Cookieless）。cfAnalyticsToken を入れた時だけ beacon を読み込む */}
    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }

    {/* JS 無効時に reveal 演出で本文が消えないよう打ち消す */}
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="relative min-h-screen bg-slate-950 font-sans text-slate-300 antialiased">
    <a
      href="#top"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      {copy.layout.skipLink}
    </a>
    {/* 背景のインディゴ・グロー（装飾。スクロールしても固定） */}
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
    >
      <div
        class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-indigo-600/20 blur-[140px]"
      >
      </div>
      <div
        class="absolute top-1/3 -left-40 h-[32rem] w-[32rem] rounded-full bg-indigo-500/10 blur-[140px]"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 h-[34rem] w-[34rem] translate-x-1/3 translate-y-1/4 rounded-full bg-violet-600/10 blur-[150px]"
      >
      </div>
    </div>

    <slot />

    {/* スクロールで静かに現れる演出。低速設定や JS 無効でも内容は常に表示される。
        スクロール速度に依存しないよう（IntersectionObserver は速いフリックで取りこぼす）、
        rAF スロットルのスクロール判定で「ビュー上端 90% より上に来た要素」を毎フレーム確定して出す。 */}
    <script>
      const els = Array.from(document.querySelectorAll(".reveal"));
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        let pending = els;
        const reveal = () => {
          const line = window.innerHeight * 0.9;
          pending = pending.filter((el) => {
            if (el.getBoundingClientRect().top < line) {
              el.classList.add("is-visible");
              return false;
            }
            return true;
          });
          if (pending.length === 0) {
            window.removeEventListener("scroll", onScroll);
            window.removeEventListener("resize", onScroll);
          }
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            reveal();
            ticking = false;
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        reveal();
      }
    </script>
  </body>
</html>
