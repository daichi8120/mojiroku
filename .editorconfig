root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust
[*.rs]
indent_size = 4

# Go-style / Makefile-like need tabs
[justfile]
indent_style = tab

[Makefile]
indent_style = tab

# Markdown: keep trailing spaces (hard line breaks)
[*.md]
trim_trailing_whitespace = false

[*.{toml,json,jsonc}]
indent_size = 2
